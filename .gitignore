# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rust/wasm build artifacts
/core-audio/wasm/target/
/core-audio/wasm/pkg/

# public/audio-engine-wasm and public/worklets hold generated output that IS committed,
# so Vercel can serve them without a Rust toolchain in the build image.
# Explicitly un-ignore them in case a broader pattern is added above.
!public/audio-engine-wasm/
!public/audio-engine-wasm/**
!public/worklets/
!public/worklets/**

# personal learning notes (do not commit)
LEARNING-RUST-WASM.md

# Copilot / assistant artifacts
copilot-instructions*
*.copilot-*
# Ignore entire .github directory (remove if you actually want workflows/issues templates)
.github/

.vscode/
